{
  "name": "@joeytheman/gemini-mcp-tool",
  "version": "2.3.0",
  "description": "MCP server for asking Gemini through Antigravity CLI (agy)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gemini-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "snippet:build": "node scripts/minify-layout-snippet.mjs",
    "test:chromium": "playwright-core install chromium-headless-shell && vitest run --config vitest.chromium.config.ts",
    "lint": "tsc --noEmit",
    "contribute": "tsx src/contribute.ts",
    "prepare": "npm run build",
    "prepublishOnly": "echo '⚠️  Remember to test locally first!' && npm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "gemini",
    "antigravity",
    "agy",
    "cli",
    "ai",
    "llm"
  ],
  "author": "joeytheman",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeytheman/gemini-mcp-tool.git"
  },
  "bugs": {
    "url": "https://github.com/joeytheman/gemini-mcp-tool/issues"
  },
  "homepage": "https://github.com/joeytheman/gemini-mcp-tool#readme",
  "engines": {
    "node": ">=20.12.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "lru-cache": "^11.5.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "^0.25.12",
    "mermaid": "^11.12.2",
    "playwright-core": "1.64.1",
    "prismjs": "^1.30.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "vite": "^6.4.4",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^4.0.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "vitepress": {
      "vite": "^6.4.4"
    },
    "mermaid": {
      "katex": "^0.18.2"
    }
  }
}
